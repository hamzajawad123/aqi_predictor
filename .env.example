# --- OpenWeather Air Pollution API ---
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Hopsworks Feature Store / Model Registry ---
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=your_hopsworks_project_name_here

# --- Target city config ---
CITY_NAME=Lahore
LATITUDE=31.5497
LONGITUDE=74.3436

# --- Data alignment (optional — defaults to 2020-11-27, the start of
# OpenWeather's free historical archive, if not set) ---
DATA_START_DATE=2020-11-27

# Local raw merged snapshot path (optional)
# RAW_DATA_PATH=data/raw/aqi_raw_merged.parquet

# --- Feature Store / Registry object names (keep consistent across pipelines) ---
FEATURE_GROUP_NAME=aqi_features
# v4 = features built on a strict hourly grid (v3 and earlier shifted by row
# position, so ~13% of their lags/targets spanned the wrong number of hours)
FEATURE_GROUP_VERSION=4
FEATURE_VIEW_NAME=aqi_feature_view
MODEL_NAME=aqi_forecaster

# --- Training window ---
# Defaults to 2025-04-04, where OpenWeather's archive changes character (mean
# hourly |AQI change| drops from ~46 to ~4.5). Training across that break is
# what made every model lose to the persistence baseline. Set to empty to
# deliberately train on all history.
TRAIN_START_DATE=2025-04-04
# Shrink predicted deltas toward 0 by a factor fitted on validation
USE_DELTA_SHRINKAGE=true

# --- FastAPI backend URL (used by the Streamlit app) ---
# When run via docker-compose, "api" is the service name and resolves automatically.
API_BASE_URL=http://api:8000
