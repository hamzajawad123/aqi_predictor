# OpenWeather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Hopsworks
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=your_hopsworks_project_name_here

# City
CITY_NAME=Lahore
LATITUDE=31.5497
LONGITUDE=74.3436

# History start (OpenWeather free archive begins 2020-11-27)
DATA_START_DATE=2020-11-27

# Local raw file (optional)
# RAW_DATA_PATH=data/raw/aqi_raw_merged.parquet

# Feature store names
FEATURE_GROUP_NAME=aqi_features
# v4 = hourly grid. Older versions had gappy lags.
FEATURE_GROUP_VERSION=4
FEATURE_VIEW_NAME=aqi_feature_view
MODEL_NAME=aqi_forecaster

# Train from this date. Empty = use all history.
TRAIN_START_DATE=2025-04-04
# Pull predicted change toward 0 using validation
USE_DELTA_SHRINKAGE=true

# FastAPI URL when the API and dashboard share one container.
API_BASE_URL=http://localhost:8000

